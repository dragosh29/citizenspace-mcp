{
  "name": "citizenspace-mcp",
  "version": "0.1.0",
  "description": "MCP server for Citizen Space (Delib): lets Claude, ChatGPT and other MCP clients search public consultations and, with a Data API key, read activities, survey structures, responses, users, workspaces and mailing lists.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node test/e2e.mjs"
  },
